# Production Environment Configuration
# Copy these settings to your deployment platform (Render, Heroku, etc.)

# JWT Secret - MUST be changed in production
JWT_SECRET=your-production-jwt-secret-here

# Database - Use your production PostgreSQL URL
# DATABASE_URL will be automatically provided by Render/Heroku
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional Services - Leave empty or comment out if not available
# REDIS_URL=redis://user:password@host:port
# NEO4J_URI=bolt://host:port
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# AI Engine - Leave empty to use mock responses
# AI_ENGINE_URL=http://your-ai-engine-url:8000

# CORS Origins - Add your frontend URLs
CORS_ORIGIN=https://risk-factor-500.onrender.com

# Optional API Keys
# GROK_API_KEY=your_grok_api_key_here
# RAZORPAY_KEY_ID=your_razorpay_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret